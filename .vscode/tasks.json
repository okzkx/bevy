{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cargo build ash_renderer (debug)",
      "type": "shell",
      "command": "cargo",
      "args": ["build", "--package", "ash_renderer", "--bin", "ash_renderer"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$rustc"]
    }
  ]
}
